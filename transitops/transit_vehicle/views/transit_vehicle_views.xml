<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vehicle Form View -->
        <record id="view_transit_vehicle_form" model="ir.ui.view">
            <field name="name">transit.vehicle.form</field>
            <field name="model">transit.vehicle</field>
            <field name="arch" type="xml">
                <form string="Vehicle">
                    <header>
                        <button name="action_set_available" string="Set Available" type="object" states="on_trip,maintenance" class="oe_highlight"/>
                        <button name="action_set_maintenance" string="Send to Maintenance" type="object" states="available" class="oe_highlight"/>
                        <button name="action_set_retired" string="Retire Vehicle" type="object" states="available,maintenance"/>
                        <field name="status" widget="statusbar" statusbar_visible="available,on_trip,maintenance,retired"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="%(action_transit_trip)d" type="action" icon="fa-truck">
                                <field string="Trips" name="trip_ids" widget="statinfo"/>
                            </button>
                        </div>
                        <field name="image_128" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="registration_number"/>
                                <field name="model"/>
                                <field name="vehicle_type_id"/>
                                <field name="fuel_type"/>
                            </group>
                            <group>
                                <field name="load_capacity"/>
                                <field name="acquisition_cost"/>
                                <field name="current_odometer"/>
                                <field name="region_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Documents">
                                <field name="document_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="document_type"/>
                                        <field name="expiry_date"/>
                                        <field name="attachment_ids" widget="many2many_binary"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Maintenance">
                                <field name="maintenance_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="type"/>
                                        <field name="status"/>
                                        <field name="date"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Vehicle Tree View -->
        <record id="view_transit_vehicle_tree" model="ir.ui.view">
            <field name="name">transit.vehicle.tree</field>
            <field name="model">transit.vehicle</field>
            <field name="arch" type="xml">
                <tree string="Vehicles">
                    <field name="registration_number"/>
                    <field name="name"/>
                    <field name="model"/>
                    <field name="vehicle_type_id"/>
                    <field name="status"/>
                    <field name="current_odometer"/>
                </tree>
            </field>
        </record>

        <!-- Vehicle Action -->
        <record id="action_transit_vehicle" model="ir.actions.act_window">
            <field name="name">Vehicles</field>
            <field name="res_model">transit.vehicle</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>

        <!-- Vehicle Kanban View -->
        <record id="view_transit_vehicle_kanban" model="ir.ui.view">
            <field name="name">transit.vehicle.kanban</field>
            <field name="model">transit.vehicle</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="status"/>
                    <field name="image_128"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="#{kanban_color(record.color.raw_value)}">
                                <div class="oe_kanban_global_click">
                                    <div class="o_kanban_image">
                                        <img t-att-src="kanban_image('transit.vehicle', 'image_128', record.id.raw_value)"/>
                                    </div>
                                    <div class="oe_kanban_details">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div><field name="registration_number"/></div>
                                        <div><field name="status" widget="badge"/></div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_transit_vehicle" name="Vehicles" parent="base.menu_transit" action="action_transit_vehicle" sequence="10"/>
    </data>
</odoo>
