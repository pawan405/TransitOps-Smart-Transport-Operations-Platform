<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Transit Admin Group -->
        <record id="group_transit_admin" model="res.groups">
            <field name="name">TransitOps Admin</field>
            <field name="category_id" ref="base.module_category_transit"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Fleet Manager Group -->
        <record id="group_transit_fleet_manager" model="res.groups">
